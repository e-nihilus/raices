# Sin estas variables puedes grabar y guardar recuerdos localmente.
# En un teléfono físico, sustituye localhost por la IP LAN de tu ordenador.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Sólo para desarrollo local; mismo valor que DEV_API_TOKEN del servidor.
EXPO_PUBLIC_DEV_API_TOKEN=
# Para modo cloud (ambas variables necesarias):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
