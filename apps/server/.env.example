PORT=3001
HOST=127.0.0.1
# Para pruebas en un teléfono de tu red: HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
DATA_DIR=.data
# Token de desarrollo compartido con la app. Necesario para arrancar el API local.
DEV_API_TOKEN=
# Nunca poner estas claves en EXPO_PUBLIC_ ni en la app.
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
TRANSCRIPTION_MODEL=whisper-1
# Cloud: ejecutar antes la migración de supabase/migrations.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Usa DATABASE_SSL=true para PostgreSQL remoto; la CA debe ser confiable.
DATABASE_SSL=false
# Certificate downloaded from Supabase: Database → Settings → SSL Configuration.
# Required when DATABASE_SSL=true with server verification enabled.
SUPABASE_CA_CERT_PATH=supabase-ca.crt
# Desactiva por completo el token local y exige sesiones Supabase:
NODE_ENV=development
